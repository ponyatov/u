# ln -fs ~/u/.unison ~/.unison/u.prf
# unison u

root = ./doc
root = /home/dponyatov/metadoc/u

prefer = newer
watch = true
batch = true

ignore = Name {.git}
ignore = Name {*~,*.log,*.sw?}
ignore = Name {bin,tmp,ref,_build,target}
ignore = Name {html}
ignore = Name {node_modules,.cache}
ignore = Name {*.pyc,__pycache__}
